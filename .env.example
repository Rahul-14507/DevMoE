# DevMoE Environment Configuration
# Copy this file to .env and fill in whichever keys you have.
# If no cloud keys are provided, DevMoE automatically operates in 100% Local Ollama Mode.

# --- Curated Free Cloud APIs ---
# Get free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Get free key at: https://console.groq.com/
GROQ_API_KEY=

# Get free key at: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# --- Optional Frontier APIs ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Local Ollama ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Gateway Security (Optional) ---
DEVMOE_API_KEY=
